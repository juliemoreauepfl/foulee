# Copie ce fichier en « secrets.toml » (même dossier) pour un usage sur ton ordi,
# ou colle son contenu dans Streamlit Cloud › ton app › Settings › Secrets.
# Ne mets JAMAIS ce fichier rempli sur GitHub.

# Ta clé Garmin Connect Personal (Garmin Connect web › Paramètres › Personal API Token)
GARMIN_API_KEY = "colle-ta-cle-ici"

# Ta base Supabase (Project Settings › API Keys)
SUPABASE_URL = "https://xxxxxxxx.supabase.co"
SUPABASE_KEY = "sb_secret_xxxxxxxxxxxx"

# Mot de passe pour ouvrir l'app (protège tes données si quelqu'un trouve le lien)
APP_PASSWORD = "choisis-un-mot-de-passe"

# Fuseau horaire (facultatif)
FUSEAU = "Europe/Paris"

# --- Si ta montre est une Polar (à la place de GARMIN_API_KEY) ---
# Client créé sur https://admin.polaraccesslink.com
# POLAR_CLIENT_ID = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# POLAR_CLIENT_SECRET = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# Adresse exacte de ton app (la même que la « redirect URL » déclarée chez Polar)
# APP_URL = "https://ton-app.streamlit.app"
